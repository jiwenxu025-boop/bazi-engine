# Do not put real credentials in this file or commit a populated .env file.
BAZI_PUBLIC=true
BAZI_AI_ENABLED=true
BAZI_FUSION_ENGINE=0
BAZI_LLM_REVIEW=0
# Use a faster model for annual reviews without changing chat/fusion/dayun.
BAZI_LLM_REVIEW_MODEL=deepseek-chat
BAZI_LLM_REVIEW_MAX_OUTPUT_TOKENS=2048
BAZI_LLM_BATCH_MAX_OUTPUT_TOKENS=3072

# Set these only in the protected production environment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Application context budget (input plus reserved output); capped by the model capacity.
BAZI_LLM_CONTEXT_LIMIT=1000000
BAZI_ADMIN_KEY=

# Optional service limits.
BAZI_MAX_AI_STREAMS=3
BAZI_CHART_AI_TOTAL_TIMEOUT=150
BAZI_FUSION_TEMPERATURE=0.3
BAZI_FUSION_REPAIR=1
